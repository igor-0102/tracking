 .primary-key { background: var(--goal); }
 .secondary-key { background: var(--accent); }
 .get-info { width: 20px; height: 20px; border: 1px solid var(--muted); border-radius: 50%; padding: 0; background: transparent; color: var(--fg); font-size: 12px; font-weight: 800; line-height: 18px; }
 .get-info-text { display: block; margin-top: 6px; max-width: 38em; line-height: 1.45; }
+.info-hint-text { display: block; margin: 6px 0 2px; max-width: 42em; line-height: 1.45; font-size: 12px; color: var(--muted); font-weight: 500; }
