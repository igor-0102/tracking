diff --git a/tests/exercise-guide.test.mjs b/tests/exercise-guide.test.mjs
new file mode 100644
index 0000000..9bfb1ac
--- /dev/null
+++ b/tests/exercise-guide.test.mjs
@@ -0,0 +1,24 @@
+import { readFile } from 'node:fs/promises';
+import vm from 'node:vm';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+const source = await readFile(new URL('../exercise-guide.js', import.meta.url), 'utf8');
+function render(exercise) {
+  const window = {};
+  vm.runInNewContext(source, { window });
+  return window.exerciseGuideHTML(exercise);
+}
+
+test('la guía resalta el grupo de un ejercicio conocido', () => {
+  const html = render({ name: 'Press banca', muscle: 'Pecho' });
+  assert.match(html, /muscle active chest/);
+  assert.match(html, /Cómo hacerlo/);
+  assert.match(html, /sin rebotar/);
+});
+
+test('la guía escapa el grupo muscular importado', () => {
+  const html = render({ name: 'Ejercicio importado', muscle: '<img src=x onerror=alert(1)>' });
+  assert.match(html, /&lt;img src=x onerror=alert\(1\)&gt;/);
+  assert.doesNotMatch(html, /<img/);
+});
diff --git a/tests/weight-xlsx.test.mjs b/tests/weight-xlsx.test.mjs
new file mode 100644
index 0000000..b50f15a
--- /dev/null
+++ b/tests/weight-xlsx.test.mjs
@@ -0,0 +1,25 @@
+import { readFile } from 'node:fs/promises';
+import vm from 'node:vm';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+const source = await readFile(new URL('../weight-xlsx.js', import.meta.url), 'utf8');
+async function workbook(entries) {
+  const window = {};
+  vm.runInNewContext(source, { window, Blob, TextEncoder });
+  return new Uint8Array(await window.createWeightWorkbook(entries).arrayBuffer());
+}
+
+test('genera un XLSX con hoja de pesos y gráfico', async () => {
+  const bytes = await workbook([{ date: '2026-01-01', kg: 80.5 }, { date: '2026-01-02', kg: 80 }]);
+  const zipText = new TextDecoder().decode(bytes);
+  assert.deepEqual([...bytes.slice(0, 4)], [0x50, 0x4b, 0x03, 0x04]);
+  assert.match(zipText, /xl\/charts\/chart1\.xml/);
+  assert.match(zipText, /80\.5/);
+  assert.match(zipText, /Progreso de peso/);
+});
+
+test('escapa valores de fecha al crear la hoja', async () => {
+  const bytes = await workbook([{ date: '<test&"', kg: 70 }]);
+  assert.match(new TextDecoder().decode(bytes), /&lt;test&amp;&quot;/);
+});
