@@ -0,0 +1,73 @@
+/* Lógica pura del descanso para poder pausar, reanudar y reiniciar también sin conexión. */
+'use strict';
+
+(() => {
+  function start(active, seconds, now, stopwatch) {
+    active.restPaused = false;
+    active.restRemaining = 0;
+    active.restElapsed = 0;
+    active.restTotal = seconds;
+    active.restEnd = stopwatch ? 0 : now + seconds * 1000;
+    active.restStart = stopwatch ? now : 0;
+    return active;
+  }
+
+  function pause(active, now, stopwatch) {
+    if (active.restPaused) return active;
+    if (stopwatch && active.restStart) {
+      active.restElapsed = (active.restElapsed || 0) + Math.max(0, now - active.restStart) / 1000;
+      active.restStart = 0;
+    } else if (active.restEnd) {
+      active.restRemaining = Math.max(0, active.restEnd - now) / 1000;
+      active.restEnd = 0;
+    } else return active;
+    active.restPaused = true;
+    return active;
+  }
+
+  function resume(active, now, stopwatch) {
+    if (!active.restPaused) return active;
+    if (stopwatch) active.restStart = now;
+    else active.restEnd = now + (active.restRemaining || 0) * 1000;
+    active.restPaused = false;
+    return active;
+  }
+
+  function toggle(active, now, stopwatch) {
+    return active.restPaused ? resume(active, now, stopwatch) : pause(active, now, stopwatch);
+  }
+
+  function reset(active, now, stopwatch) {
+    active.restPaused = false;
+    active.restRemaining = 0;
+    active.restElapsed = 0;
+    active.restEnd = stopwatch ? 0 : now + (active.restTotal || 0) * 1000;
+    active.restStart = stopwatch ? now : 0;
+    return active;
+  }
+
+  function adjust(active, deltaSeconds, now) {
+    if (active.restPaused) active.restRemaining = Math.max(1, (active.restRemaining || 0) + deltaSeconds);
+    else if (active.restEnd) active.restEnd = Math.max(now + 1000, active.restEnd + deltaSeconds * 1000);
+    active.restTotal = Math.max(1, (active.restTotal || 1) + deltaSeconds);
+    return active;
+  }
+
+  function stop(active) {
+    active.restEnd = 0;
+    active.restStart = 0;
+    active.restRemaining = 0;
+    active.restElapsed = 0;
+    active.restPaused = false;
+    return active;
+  }
+
+  function read(active, now, stopwatch) {
+    if (active.restPaused) return { seconds: stopwatch ? active.restElapsed || 0 : active.restRemaining || 0, fraction: 0 };
+    if (stopwatch) return { seconds: (active.restElapsed || 0) + Math.max(0, now - (active.restStart || now)) / 1000, fraction: 1 };
+    const seconds = Math.max(0, (active.restEnd - now) / 1000);
+    return { seconds, fraction: Math.min(1, seconds / (active.restTotal || 1)) };
+  }
+
+  window.GymRest = Object.freeze({ start, pause, resume, toggle, reset, adjust, stop, read });
+})();
diff --git a/gym-summary-comparison.js b/gym-summary-comparison.js
new file mode 100644
index 0000000..d909fbc
--- /dev/null
+++ b/gym-summary-comparison.js
@@ -0,0 +1,50 @@
+/* Completa el resumen al terminar con la sesión comparable más reciente. */
+'use strict';
+
+(() => {
+  const volume = workout => (workout.exercises || []).reduce((total, exercise) => total
+    + (exercise.sets || []).filter(set => set.type !== 'warmup').reduce((sum, set) => sum + (set.kg || 0) * (set.reps || 0), 0), 0);
+  const setCount = workout => (workout.exercises || []).reduce((total, exercise) => total
+    + (exercise.sets || []).filter(set => set.type !== 'warmup').length, 0);
+  const exerciseIds = workout => [...new Set((workout.exercises || []).map(ex => ex.exId))].sort();
+  const sameExercises = (left, right) => {
+    const a = exerciseIds(left), b = exerciseIds(right);
+    return a.length > 0 && a.length === b.length && a.every((id, index) => id === b[index]);
+  };
+
+  function comparable(workout, history) {
+    return history.filter(item => item.id !== workout.id && item.start < workout.start)
+      .filter(item => (workout.routineId && item.routineId === workout.routineId)
+        || (item.title === workout.title) || sameExercises(workout, item))
+      .sort((a, b) => b.start - a.start)[0] || null;
+  }
+
+  function comparison(workout, history) {
+    const previous = comparable(workout, history);
+    if (!previous) return null;
+    return { previous, volumeDelta: volume(workout) - volume(previous), setDelta: setCount(workout) - setCount(previous),
+      durationDelta: (workout.end - workout.start) - (previous.end - previous.start) };
+  }
+
+  function comparisonCard(result) {
+    if (!result) return null;
+    const card = document.createElement('div');
+    card.className = 'card summary-comparison';
+    const delta = value => `${value > 0 ? '+' : ''}${Math.round(value).toLocaleString('es-ES')}`;
+    const unit = GymUnits.unitFor('weight'), volumeDelta = result.volumeDelta * (unit === 'lb' ? 2.2046226218 : 1);
+    card.innerHTML = `<div class="label">Comparación con «${esc(result.previous.title || 'Entreno anterior')}»</div><p>Volumen ${delta(volumeDelta)} ${unit} · Series ${delta(result.setDelta)} · Duración ${delta(result.durationDelta / 60000)} min</p>`;
+    return card;
+  }
+
+  const original = showSummary;
+  showSummary = async (...args) => {
+    await original(...args);
+    const result = comparison(args[0], G.workouts);
+    const pages = document.querySelectorAll('body > .page');
+    const body = pages[pages.length - 1]?.querySelector('.page-body');
+    const card = comparisonCard(result);
+    const stats = body && body.querySelector('.stats');
+    if (stats && card) stats.after(card);
+  };
+  window.GymSummaryComparison = Object.freeze({ volume, setCount, sameExercises, comparison });
+})();
