+.exercise-analysis .stat { min-width: 0; }
+.exercise-analysis .val { overflow-wrap: anywhere; font-size: 17px; }
+.pick-section > b { display: block; margin: 10px 2px 5px; color: var(--muted); font-size: 12px; }
+.muscle-map { max-height: 220px; stroke-width: 1.5; }
