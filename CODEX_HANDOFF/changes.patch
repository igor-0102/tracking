diff --git a/styles.css b/styles.css
index e97772d..bb8ccdb 100644
--- a/styles.css
+++ b/styles.css
@@ -706,13 +706,25 @@ body:not(.page-open) .rest-bar { bottom: calc(var(--nav-h) + var(--safe-b) + 76p
 .sq-no.on { background: var(--bad); border-color: var(--bad); color: #fff; }
 .done-extra { margin: 10px 0 0; font-size: 14px; color: var(--muted); font-weight: 600; }
 .cheat-meal { margin-top: 10px; }
-.exercise-guide { display: grid; grid-template-columns: 110px 1fr; gap: 14px; align-items: center; }
+.exercise-guide { display: grid; grid-template-columns: minmax(142px, 176px) 1fr; gap: 14px; align-items: center; }
 .exercise-guide h3 { margin: 3px 0 6px; font-size: 16px; }
-.exercise-guide p { margin: 0 0 7px; font-size: 14px; line-height: 1.45; }
 .exercise-guide small { color: var(--muted); font-size: 11px; line-height: 1.35; }
-.muscle-map { width: 100%; max-height: 145px; fill: var(--surface-2); stroke: var(--muted); stroke-width: 2; stroke-linejoin: round; }
+.exercise-maps { display: grid; grid-template-columns: 1fr 1fr; align-items: end; gap: 3px; }
+.muscle-map { width: 100%; max-height: 184px; fill: transparent; stroke: var(--muted); stroke-width: 1.5; stroke-linejoin: round; }
+.muscle-map .silhouette { fill: var(--surface-2); stroke: var(--muted); }
 .muscle-map .muscle { fill: var(--line); stroke: var(--surface); stroke-width: 1; }
-.muscle-map .muscle.active { fill: var(--goal); }
+.muscle-map .muscle.primary { fill: var(--goal); }
+.muscle-map .muscle.secondary { fill: var(--accent); }
+.map-legend { grid-column: 1 / -1; display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; color: var(--muted); font-size: 10px; }
+.map-legend span { display: inline-flex; align-items: center; gap: 4px; }
+.map-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--goal); }
+.map-dot.assist { background: var(--accent); }
+.exercise-steps { margin: 0 0 8px; padding-left: 18px; font-size: 13px; line-height: 1.42; }
+.exercise-steps li { padding-left: 2px; margin: 0 0 5px; }
+@media (max-width: 520px) {
+  .exercise-guide { grid-template-columns: 1fr; }
+  .exercise-maps { width: min(100%, 290px); margin: 0 auto 4px; }
+}
 .wstrip { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; margin-top: 12px; }
 .wday { border: 2px solid transparent; border-radius: 12px; background: var(--surface-2); min-height: 52px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px; color: var(--muted); padding: 0; }
 .wday small { font-size: 11px; font-weight: 700; text-transform: capitalize; }
