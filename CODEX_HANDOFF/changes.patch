--- /dev/null
+++ b/tests/diet-adjustment.test.mjs
@@ -0,0 +1,31 @@
+// Claude: comprueba conversiones GET, el ejemplo de déficit y los rangos de grasa.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+
+const require = createRequire(import.meta.url);
+const adjustment = require('../diet-adjustment.js');
+
+test('convierte de porcentaje a kcal y de kcal a porcentaje con el mismo GET', () => {
+  const difference = adjustment.caloriesForAdjustment(2400, -20);
+  assert.equal(difference, -480);
+  assert.equal(adjustment.percentForAdjustment(2400, difference), -20);
+});
+
+test('parsea decimales con coma y signos menos tipográficos', () => {
+  assert.equal(adjustment.parseNumber('−800,5'), -800.5);
+  assert.equal(adjustment.parseNumber('no es un número'), null);
+});
+
+test('convierte la recomendación de grasa de la OMS a g/kg para el perfil actual', () => {
+  const range = adjustment.fatRangePerKg(2000, 80);
+  assert.equal(range.min, 2000 * 0.15 / 9 / 80);
+  assert.equal(range.max, 2000 * 0.30 / 9 / 80);
+  assert.equal(adjustment.fatRangePerKg(0, 80), null);
+});
+
+test('el ejemplo solicitado de 80 kg calcula 0,8 kg por semana y 800 kcal al día', () => {
+  assert.deepEqual(adjustment.aggressiveDeficitExample(80), {
+    maxWeeklyLossKg: 0.8, weeklyDeficit: 5600, dailyDeficit: 800,
+  });
+});
diff --git a/tests/exercise-catalog.test.mjs b/tests/exercise-catalog.test.mjs
new file mode 100644
index 0000000..921ccac
--- /dev/null
+++ b/tests/exercise-catalog.test.mjs
@@ -0,0 +1,34 @@
+// Claude: valida búsqueda local, sin acentos y sin depender de la red.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+
+const require = createRequire(import.meta.url);
+const catalog = require('../exercise-catalog.js');
+
+test('el catálogo local incluye una base amplia sin depender de red', () => {
+  assert.ok(catalog.exercises.length >= 80);
+  assert.equal(new Set(catalog.exercises.map(item => item.id)).size, catalog.exercises.length);
+});
+
+test('buscar press devuelve variantes de barra, mancuerna y máquina', () => {
+  const results = catalog.search('press');
+  assert.ok(results.length >= 15);
+  assert.ok(results.some(item => /barra/i.test(item.name)));
+  assert.ok(results.some(item => /mancuerna/i.test(item.name)));
+  assert.ok(results.some(item => /máquina/i.test(item.name)));
+});
+
+test('la búsqueda incremental y sin tildes encuentra sentadilla y sus variantes', () => {
+  assert.ok(catalog.search('s').length > catalog.search('se').length);
+  assert.ok(catalog.search('sentadilla').some(item => item.name === 'Sentadilla con barra'));
+  assert.ok(catalog.search('bulgara').some(item => item.id === 'sentadilla-bulgara'));
+});
+
+test('se puede filtrar por músculo, material y alias en inglés', () => {
+  assert.ok(catalog.search('row', { muscle: 'Espalda' }).some(item => item.id === 'remo-barra'));
+  assert.ok(catalog.search('', { equipment: 'Máquina' }).every(item => item.equipment === 'Máquina'));
+  const chestPresses = catalog.search('press', { muscle: 'Pecho' });
+  assert.ok(chestPresses.length > 0);
+  assert.ok(chestPresses.every(item => item.muscle === 'Pecho'));
+});
diff --git a/tests/gym-dashboard-analysis.test.mjs b/tests/gym-dashboard-analysis.test.mjs
